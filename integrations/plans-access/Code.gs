/**
 * MarketCap · Plans access (Google Apps Script, bound to the access sheet)
 *
 * Email + PIN access to the development plans on the website.
 *   - Access tab: one row per email. Status is a dropdown:
 *     Pending → Approved (PIN generated and emailed) → Revoked.
 *   - Log tab: every request, login, failed login, plan view, approval,
 *     PIN email and revocation, with time, email, page title and URL.
 *   - Settings tab: who gets the request emails, auto-approve, wording.
 *
 * The website (src/modules/plans-gate.ts) talks to this script through its
 * web app URL. Setup steps: integrations/plans-access/README.md.
 * No secrets live in this file: the signing secret is generated by
 * setup() and kept in Script Properties.
 */

const ACCESS = 'Access';
const LOG = 'Log';
const SETTINGS = 'Settings';
const COLS = ['Email', 'Name', 'Company', 'Status', 'PIN', 'Requested', 'Approved', 'Last login', 'Logins', 'First page', 'Notes'];
const C = Object.fromEntries(COLS.map((name, i) => [name, i + 1]));
const STATUSES = ['Pending', 'Approved', 'Revoked'];
const LOG_COLS = ['Time', 'Event', 'Email', 'Page title', 'Page URL', 'Detail', 'Device'];
const TOKEN_DAYS_DEFAULT = 30;
const MAX_FAILS = 5;            // wrong PINs per email before a lockout
const LOCK_MINUTES = 15;

/* ---------- one-time setup and the sheet menu ---------- */

function setup() {
  const ss = SpreadsheetApp.getActive();
  const access = sheet_(ACCESS, COLS);
  const log = sheet_(LOG, LOG_COLS);
  const settings = sheet_(SETTINGS, ['Setting', 'Value', 'Notes']);
  // Add any setting that isn't there yet (re-running setup keeps your values).
  const defaults = [
    ['Notify emails', Session.getEffectiveUser().getEmail(), 'Who gets "new request" emails. Any addresses, separated by commas.'],
    ['Auto-approve', 'No', 'Yes = every request is approved and gets a PIN at once, with no click needed.'],
    ['Site name', 'MarketCap', 'Used in the email subject lines.'],
    ['Sender name', 'MarketCap', 'Shown as the sender name. The address is always the Google account that runs this script.'],
    ['Days signed in', TOKEN_DAYS_DEFAULT, 'How long a device stays unlocked after a login.'],
    ['Reply-to email', '', 'Optional: replies to the PIN and request emails go here (e.g. the client), not to the sending account.'],
  ];
  const have = settings.getLastRow() > 1 ? settings.getRange(2, 1, settings.getLastRow() - 1, 1).getValues().map((r) => String(r[0]).trim()) : [];
  defaults.filter((d) => have.indexOf(d[0]) < 0).forEach((d) => settings.appendRow(d));
  const rows = settings.getRange(2, 1, settings.getLastRow() - 1, 1).getValues().map((r) => String(r[0]).trim());
  settings.getRange(rows.indexOf('Auto-approve') + 2, 2).setDataValidation(
    SpreadsheetApp.newDataValidation().requireValueInList(['No', 'Yes'], true).build());
  access.getRange(2, C.Status, 1000).setDataValidation(
    SpreadsheetApp.newDataValidation().requireValueInList(STATUSES, true).setAllowInvalid(false).build());
  const rules = [['Approved', '#d9ead3'], ['Pending', '#fff2cc'], ['Revoked', '#f4cccc']].map(([text, bg]) =>
    SpreadsheetApp.newConditionalFormatRule().whenTextEqualTo(text).setBackground(bg)
      .setRanges([access.getRange(2, C.Status, 1000)]).build());
  access.setConditionalFormatRules(rules);
  access.setFrozenRows(1);
  log.setFrozenRows(1);
  settings.setFrozenRows(1);
  [access, log, settings].forEach((s) => s.getRange(1, 1, 1, s.getLastColumn()).setFontWeight('bold'));

  const props = PropertiesService.getScriptProperties();
  if (!props.getProperty('SECRET')) props.setProperty('SECRET', Utilities.getUuid() + Utilities.getUuid());
  // An installable edit trigger can send email; the simple onEdit can't.
  ScriptApp.getProjectTriggers().filter((t) => t.getHandlerFunction() === 'handleEdit').forEach((t) => ScriptApp.deleteTrigger(t));
  ScriptApp.newTrigger('handleEdit').forSpreadsheet(ss).onEdit().create();
  ss.toast('Plans access is set up. Now deploy it as a web app (see the README).');
}

function onOpen() {
  SpreadsheetApp.getUi().createMenu('Plans access')
    .addItem('Approve selected rows', 'menuApprove')
    .addItem('Email PIN again to selected rows', 'menuResend')
    .addItem('Revoke selected rows', 'menuRevoke')
    .addSeparator()
    .addItem('Run setup', 'setup')
    .addToUi();
}

function menuApprove() { selectedEmails_().forEach((e) => approve_(e, 'menu')); }
function menuResend() { selectedEmails_().forEach((e) => resendPin_(e, 'menu')); }
function menuRevoke() { selectedEmails_().forEach((e) => setStatus_(e, 'Revoked', 'menu')); }

/** A row edited by hand (email or status, in either order): Approved with no
 *  PIN yet sends the PIN; Revoked is logged. */
function handleEdit(e) {
  const range = e.range;
  if (range.getSheet().getName() !== ACCESS || range.getColumn() > C.Status) return;
  for (let r = range.getRow(); r <= range.getLastRow(); r++) {
    if (r < 2) continue;
    const row = range.getSheet().getRange(r, 1, 1, COLS.length).getValues()[0];
    const email = norm_(row[C.Email - 1]);
    const status = row[C.Status - 1];
    if (!email) continue;
    if (status === 'Approved' && !row[C.PIN - 1]) approve_(email, 'sheet');
    else if (status === 'Revoked' && range.getColumn() <= C.Status && range.getLastColumn() >= C.Status && e.oldValue !== 'Revoked') log_('revoked', email, {}, 'by sheet');
  }
}

/* ---------- web app ---------- */

/** All calls from the website are POSTs with a JSON body sent as text/plain
 *  (no CORS preflight). Replies are JSON. */
function doPost(e) {
  let body = {};
  try { body = JSON.parse(e.postData.contents || '{}'); } catch (err) { return json_({ ok: false, reason: 'bad' }); }
  const page = { title: String(body.title || '').slice(0, 200), url: String(body.url || '').slice(0, 500), ua: String(body.ua || '').slice(0, 300) };
  try {
    if (body.action === 'login') return json_(login_(norm_(body.email), String(body.pin || ''), page));
    if (body.action === 'check') return json_(check_(String(body.token || ''), page));
    if (body.action === 'request') return json_(request_(body, page));
  } catch (err) {
    log_('error', norm_(body.email), page, String(err));
    return json_({ ok: false, reason: 'error' });
  }
  return json_({ ok: false, reason: 'bad' });
}

/** One-click approval from the request email: ?a=approve&e=<email>&s=<signature>. */
function doGet(e) {
  const p = e.parameter || {};
  if (p.a === 'approve' && p.e && p.s === sign_('approve:' + norm_(p.e))) {
    const result = approve_(norm_(p.e), 'email button');
    return page_(result.ok ? 'Access approved' : 'Nothing to approve',
      result.ok ? 'A PIN has been emailed to ' + norm_(p.e) + '. They can now see the plans.' : result.message);
  }
  return page_('Plans access', 'This link is not valid.');
}

function login_(email, pin, page) {
  if (!valid_(email) || !/^\d{4}$/.test(pin)) return { ok: false, reason: 'wrong' };
  const cache = CacheService.getScriptCache();
  const failKey = 'fail:' + email;
  const fails = Number(cache.get(failKey) || 0);
  if (fails >= MAX_FAILS) { log_('login_locked', email, page, 'too many wrong PINs'); return { ok: false, reason: 'locked' }; }
  const found = find_(email);
  const status = found ? found.row[C.Status - 1] : '';
  if (found && status === 'Approved' && String(found.row[C.PIN - 1]) === pin) {
    cache.remove(failKey);
    const sheet = found.sheet;
    sheet.getRange(found.r, C['Last login']).setValue(new Date());
    sheet.getRange(found.r, C.Logins).setValue(Number(found.row[C.Logins - 1] || 0) + 1);
    log_('login', email, page, '');
    return { ok: true, token: token_(email) };
  }
  cache.put(failKey, String(fails + 1), LOCK_MINUTES * 60);
  const why = !found ? 'no access' : status === 'Approved' ? 'wrong PIN' : status.toLowerCase();
  log_('login_failed', email, page, why);
  return { ok: false, reason: found && status === 'Pending' ? 'pending' : 'wrong' };
}

/** A remembered device opening the plans: re-checked so a revoke works at once. */
function check_(token, page) {
  const email = verify_(token);
  if (!email) return { ok: false };
  const found = find_(email);
  if (!found || found.row[C.Status - 1] !== 'Approved') {
    log_('view_denied', email, page, found ? String(found.row[C.Status - 1]).toLowerCase() : 'no access');
    return { ok: false };
  }
  log_('view', email, page, 'remembered device');
  return { ok: true, email: email };
}

function request_(body, page) {
  const email = norm_(body.email);
  if (body.website) return { ok: true, state: 'requested' };            // honeypot: bots fill it
  if (!valid_(email)) return { ok: false, reason: 'email' };
  const cache = CacheService.getScriptCache();
  if (cache.get('req:' + email)) return { ok: true, state: 'wait' };      // one request per 2 minutes
  cache.put('req:' + email, '1', 120);
  const name = String(body.name || '').trim().slice(0, 120);
  const company = String(body.company || '').trim().slice(0, 120);
  const found = find_(email);
  if (found && found.row[C.Status - 1] === 'Approved') {
    resendPin_(email, 'visitor asked again');
    return { ok: true, state: 'sent' };
  }
  if (found) {
    log_('request_again', email, page, String(found.row[C.Status - 1]).toLowerCase());
    return { ok: true, state: 'pending' };
  }
  withLock_(() => {
    sheet_(ACCESS, COLS).appendRow([email, name, company, 'Pending', '', new Date(), '', '', 0, page.title || page.url, '']);
  });
  log_('request', email, page, [name, company].filter(String).join(' · '));
  if (setting_('Auto-approve', 'No') === 'Yes') {
    approve_(email, 'auto-approve');
    return { ok: true, state: 'sent' };
  }
  notifyAdmins_(email, name, company, page);
  return { ok: true, state: 'requested' };
}

/* ---------- approve, resend, revoke ---------- */

function approve_(email, by) {
  return withLock_(() => {
    const found = find_(email);
    if (!found) return { ok: false, message: email + ' is not on the access list.' };
    const s = found.sheet;
    const already = found.row[C.Status - 1] === 'Approved' && found.row[C.PIN - 1];
    const pin = already ? String(found.row[C.PIN - 1]) : newPin_();
    if (!already) {
      s.getRange(found.r, C.Status).setValue('Approved');
      s.getRange(found.r, C.PIN).setNumberFormat('@').setValue(pin);
      s.getRange(found.r, C.Approved).setValue(new Date());
      log_('approved', email, {}, 'by ' + by);
    }
    sendPin_(email, found.row[C.Name - 1], pin);
    return { ok: true, message: already ? 'Already approved; the PIN was emailed again.' : 'Approved.' };
  });
}

function resendPin_(email, by) {
  const found = find_(email);
  if (!found || found.row[C.Status - 1] !== 'Approved') return;
  sendPin_(email, found.row[C.Name - 1], String(found.row[C.PIN - 1]));
  log_('pin_resent', email, {}, 'by ' + by);
}

function setStatus_(email, status, by) {
  const found = find_(email);
  if (!found) return;
  found.sheet.getRange(found.r, C.Status).setValue(status);
  log_(status.toLowerCase(), email, {}, 'by ' + by);
}

/* ---------- email ---------- */

function sendPin_(email, name, pin) {
  const site = setting_('Site name', 'MarketCap');
  const hello = name ? 'Hi ' + escape_(String(name).split(' ')[0]) + ',' : 'Hello,';
  mail_({
    to: email,
    name: setting_('Sender name', site),
    subject: 'Your PIN for the ' + site + ' development plans',
    htmlBody:
      '<div style="font:16px/1.5 Helvetica,Arial,sans-serif;color:#260b07">' +
      '<p>' + hello + '</p><p>You now have access to the development plans on the ' + escape_(site) + ' website.</p>' +
      '<p>Enter this email address and your PIN:</p>' +
      '<p style="font-size:32px;letter-spacing:0.3em;font-weight:600;margin:16px 0">' + escape_(pin) + '</p>' +
      '<p>The PIN is for you only. Your device stays signed in for ' + setting_('Days signed in', TOKEN_DAYS_DEFAULT) + ' days.</p></div>',
  });
  log_('pin_sent', email, {}, '');
}

function notifyAdmins_(email, name, company, page) {
  const to = String(setting_('Notify emails', '')).trim();
  if (!to) return;
  const url = ScriptApp.getService().getUrl() + '?a=approve&e=' + encodeURIComponent(email) + '&s=' + encodeURIComponent(sign_('approve:' + email));
  const site = setting_('Site name', 'MarketCap');
  mail_({
    to: to,
    name: setting_('Sender name', site),
    subject: 'Plans access request: ' + (name || email),
    htmlBody:
      '<div style="font:16px/1.5 Helvetica,Arial,sans-serif;color:#260b07">' +
      '<p><b>' + escape_(name || '(no name)') + '</b>' + (company ? ' · ' + escape_(company) : '') + '<br>' + escape_(email) + '</p>' +
      '<p>Asked for access on: ' + escape_(page.title || page.url || 'the website') + '</p>' +
      '<p><a href="' + url + '" style="display:inline-block;background:#824331;color:#fff;padding:12px 22px;text-decoration:none;border-radius:2px">Approve and send PIN</a></p>' +
      '<p style="color:#7a6a64;font-size:13px">Or set their Status to Approved in the access sheet. To ignore the request, do nothing.</p></div>',
  });
}

/* ---------- helpers ---------- */

function sheet_(name, header) {
  const ss = SpreadsheetApp.getActive();
  let s = ss.getSheetByName(name);
  if (!s) s = ss.insertSheet(name);
  if (s.getLastRow() === 0) s.appendRow(header);
  return s;
}

function find_(email) {
  const s = sheet_(ACCESS, COLS);
  const n = s.getLastRow() - 1;
  if (n < 1) return null;
  const rows = s.getRange(2, 1, n, COLS.length).getValues();
  for (let i = 0; i < rows.length; i++) {
    if (norm_(rows[i][C.Email - 1]) === email) return { sheet: s, r: i + 2, row: rows[i] };
  }
  return null;
}

function selectedEmails_() {
  const s = SpreadsheetApp.getActiveSheet();
  if (s.getName() !== ACCESS) { SpreadsheetApp.getUi().alert('Select rows on the Access tab first.'); return []; }
  const range = s.getActiveRange();
  return s.getRange(range.getRow(), C.Email, range.getNumRows(), 1).getValues()
    .map((r) => norm_(r[0])).filter((e, i) => e && range.getRow() + i > 1);
}

function log_(event, email, page, detail) {
  const p = page || {};
  sheet_(LOG, LOG_COLS).appendRow([new Date(), event, email || '', p.title || '', p.url || '', detail || '', p.ua || '']);
}

function setting_(name, fallback) {
  const s = SpreadsheetApp.getActive().getSheetByName(SETTINGS);
  if (!s || s.getLastRow() < 2) return fallback;
  const rows = s.getRange(2, 1, s.getLastRow() - 1, 2).getValues();
  const hit = rows.find((r) => String(r[0]).trim() === name);
  return hit && hit[1] !== '' ? hit[1] : fallback;
}

function newPin_() {
  let pin;
  do { pin = String(Math.floor(Math.random() * 10000)).padStart(4, '0'); } while (/^(\d)\1{3}$/.test(pin) || pin === '1234');
  return pin;
}

function token_(email) {
  const days = Number(setting_('Days signed in', TOKEN_DAYS_DEFAULT)) || TOKEN_DAYS_DEFAULT;
  const payload = Utilities.base64EncodeWebSafe(JSON.stringify({ e: email, x: Date.now() + days * 864e5 }));
  return payload + '.' + sign_(payload);
}

function verify_(token) {
  const [payload, sig] = token.split('.');
  if (!payload || sig !== sign_(payload)) return '';
  try {
    const data = JSON.parse(Utilities.newBlob(Utilities.base64DecodeWebSafe(payload)).getDataAsString());
    return data.x > Date.now() ? norm_(data.e) : '';
  } catch (err) { return ''; }
}

function sign_(value) {
  const secret = PropertiesService.getScriptProperties().getProperty('SECRET');
  if (!secret) throw new Error('Run setup() first.');
  return Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(value, secret)).replace(/=+$/, '');
}

function withLock_(fn) {
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try { return fn(); } finally { lock.releaseLock(); }
}

/** MailApp with the optional Reply-to setting (only passed when it's a valid address). */
function mail_(options) {
  const r = String(setting_('Reply-to email', '')).trim();
  if (valid_(norm_(r))) options.replyTo = r;
  MailApp.sendEmail(options);
}

function norm_(email) { return String(email || '').trim().toLowerCase(); }
function valid_(email) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email); }
function escape_(s) { return String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c])); }
function json_(obj) { return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON); }
function page_(title, text) {
  return HtmlService.createHtmlOutput('<div style="font:18px/1.5 Helvetica,Arial,sans-serif;color:#260b07;max-width:32em;margin:12vh auto;padding:0 24px">' +
    '<h1 style="font-weight:500">' + escape_(title) + '</h1><p>' + escape_(text) + '</p></div>').setTitle(title);
}
